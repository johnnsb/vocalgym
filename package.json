{
  "name": "vocalgym",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/devCacheGuard.mjs",
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "eval": "tsx evals/run.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.72.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.38.0",
    "next": "14.2.35",
    "pdfjs-dist": "^6.2.108",
    "posthog-js": "^1.422.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.47",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "@sentry/cli@2.58.6": true,
    "core-js": false,
    "fsevents": false,
    "unrs-resolver": false
  }
}
