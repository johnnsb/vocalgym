# Copy this file to .env.local and fill in your key.
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Only required if your API key is "identity-linked" (the API returns a 400
# asking for anthropic-workspace-id). Find the ID in the Console URL for your
# workspace: /workspaces/<ANTHROPIC_WORKSPACE_ID>/... — leave blank otherwise.
ANTHROPIC_WORKSPACE_ID=

# --- Demo usage cap (optional) -------------------------------------------------
# Combined limit across /api/generate-script and /api/practice-feedback. Once
# reached, both routes return a "Demo limit reached" error instead of calling
# Anthropic. Leave blank or 0 to disable the cap.
DEMO_REQUEST_LIMIT=100

# Where the shared counter is stored. Defaults to .vocalgym-usage.json in the
# project root. On Vercel, point this at /tmp (per-instance) or swap to KV.
# USAGE_COUNTER_FILE=

# If set, this token also gates GET /api/usage-count, GET /api/expert-request,
# and the /admin/requests page (?token=... or x-admin-token header). If blank,
# those are open.
# USAGE_ADMIN_TOKEN=

# Where "get expert help" requests are saved (see /admin/requests). Defaults to
# .vocalgym-expert-requests.json in the project root. Same Vercel FS caveat as
# the usage counter.
# EXPERT_REQUESTS_FILE=

# --- Error tracking (optional) -----------------------------------------------
# Sentry DSN for both server and browser error reporting. Leave blank and Sentry
# stays fully disabled (every capture call is a no-op). Uses the NEXT_PUBLIC_
# prefix because it must be readable in the browser — unlike ANTHROPIC_API_KEY,
# a DSN is not a secret. Create a project at https://sentry.io and copy its DSN.
NEXT_PUBLIC_SENTRY_DSN=

# --- Product analytics (optional) -------------------------------------------
# PostHog project API key for navigation/engagement analytics + in-app feedback
# surveys. Leave blank and PostHog stays fully disabled — the SDK isn't even
# loaded. NEXT_PUBLIC_ because it runs in the browser; a project API key is not
# a secret. Create a project at https://posthog.com and copy the key.
# Only navigation and named interaction events are sent — never script text,
# transcripts, or feedback content.
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com. Set to https://eu.i.posthog.com for the
# EU cloud, or your self-hosted URL.
# NEXT_PUBLIC_POSTHOG_HOST=
