# Copy this file to .env.local and fill in your key.
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Only required if your API key is "identity-linked" (the API returns a 400
# asking for anthropic-workspace-id). Find the ID in the Console URL for your
# workspace: /workspaces/<ANTHROPIC_WORKSPACE_ID>/... — leave blank otherwise.
ANTHROPIC_WORKSPACE_ID=

# --- Database (Prisma / Postgres) -------------------------------------------
# Two connection strings, both secret. Also put these in a `.env` file — the
# Prisma CLI (migrate / generate / studio) only reads `.env`, not `.env.local`.
#   DATABASE_URL        — DIRECT connection. Used by `prisma migrate` and
#                         introspection. schema.prisma reads it as `directUrl`.
#   DATABASE_URL_POOLED — POOLED connection (Neon -pooler / PgBouncer / Supabase
#                         pooler). Used by @prisma/client at runtime.
#                         schema.prisma reads it as `url`. For a PgBouncer pool
#                         append `?pgbouncer=true` (or `&pgbouncer=true`).
# If your provider doesn't offer a separate pooled endpoint, set both the same.
DATABASE_URL=
DATABASE_URL_POOLED=

# --- Demo usage cap (optional) -------------------------------------------------
# Combined limit across /api/generate-script and /api/practice-feedback. Once
# reached, both routes return a "Demo limit reached" error instead of calling
# Anthropic. Leave blank or 0 to disable the cap.
DEMO_REQUEST_LIMIT=100

# If set, this token gates GET /api/usage-count, GET /api/expert-request, and
# the /admin/requests page (?token=... or x-admin-token header). If blank, those
# are open.
# USAGE_ADMIN_TOKEN=

# --- Site-wide password gate (optional) --------------------------------------
# If set, EVERY route is gated behind /gate until the visitor enters this
# password (middleware.ts checks a long-lived `vg_gate` cookie on every
# request). Leave blank and the gate is fully bypassed — this is what keeps
# local dev working exactly as before. Useful for e.g. gating a staging/preview
# deploy. Not related to USAGE_ADMIN_TOKEN above (that gates a couple of admin
# endpoints; this gates the whole app).
# SITE_PASSWORD=

# --- Error tracking (optional) -----------------------------------------------
# Sentry DSN for both server and browser error reporting. Leave blank and Sentry
# stays fully disabled (every capture call is a no-op). Uses the NEXT_PUBLIC_
# prefix because it must be readable in the browser — unlike ANTHROPIC_API_KEY,
# a DSN is not a secret. Create a project at https://sentry.io and copy its DSN.
NEXT_PUBLIC_SENTRY_DSN=

# Source-map upload (optional; only affects `next build`, never `npm run dev`).
# Set all three and a production build uploads source maps to Sentry so stack
# traces point at your real TypeScript instead of minified output. Leave any of
# them blank and the upload is skipped — error capture still works, traces just
# stay minified. Ignored entirely when NEXT_PUBLIC_SENTRY_DSN is blank.
#   SENTRY_ORG        — your Sentry org slug. In the dashboard URL
#                       https://<org>.sentry.io/ or Settings -> General; it's
#                       the short slug, not the display name.
#   SENTRY_PROJECT    — the project slug (Settings -> Projects -> your project,
#                       or the /projects/<slug>/ path segment). Same project the
#                       DSN above belongs to.
#   SENTRY_AUTH_TOKEN — SECRET. An auth token with the `project:releases` scope
#                       (and `org:read`). Create at
#                       https://sentry.io/settings/account/api/auth-tokens/ or
#                       Settings -> Auth Tokens. Do not commit it; in CI/hosting
#                       set it as an encrypted secret, not plain env.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# --- Product analytics (optional) -------------------------------------------
# PostHog project API key for navigation/engagement analytics + in-app feedback
# surveys. Leave blank and PostHog stays fully disabled — the SDK isn't even
# loaded. NEXT_PUBLIC_ because it runs in the browser; a project API key is not
# a secret. Create a project at https://posthog.com and copy the key.
# Only navigation and named interaction events are sent — never script text,
# transcripts, or feedback content.
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com. Set to https://eu.i.posthog.com for the
# EU cloud, or your self-hosted URL.
# NEXT_PUBLIC_POSTHOG_HOST=
